%rename link	picolibc_link
%rename link_libgcc	picolibc_link_libgcc
%rename cpp	picolibc_cpp
%rename cc1	picolibc_cc1
%rename cc1plus	picolibc_cc1plus

*cpp:
-isystem %{-picolibc-prefix=*:%*/picolibc/msp430/include/; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/%*; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include} -isystem %{-picolibc-prefix=*:%*/picolibc/msp430/include/../msp430-elf/include/c++/%(version)/msp430-elf/%M; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/%*/../msp430-elf/include/c++/%(version)/msp430-elf/%M; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/../msp430-elf/include/c++/%(version)/msp430-elf/%M} %{-printf=*: -D_PICOLIBC_PRINTF='%*'} %{-scanf=*: -D_PICOLIBC_SCANF='%*'} %(picolibc_cpp)

*cc1:
   %(picolibc_cc1)

*cc1plus:
-isystem %{-picolibc-prefix=*:%*/picolibc/msp430/include/; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/%*; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include} -isystem %{-picolibc-prefix=*:%*/picolibc/msp430/include/../msp430-elf/include/c++/%(version)/msp430-elf/%M; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/%*/../msp430-elf/include/c++/%(version)/msp430-elf/%M; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/../msp430-elf/include/c++/%(version)/msp430-elf/%M}     %(picolibc_cc1plus)

*link_libgcc:
-L%{-picolibc-prefix=*:%*/picolibc/msp430/include/../lib/gcc/msp430-elf/%(version); -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/../lib/gcc/msp430-elf/%(version)/%*; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/include/../lib/gcc/msp430-elf/%(version)} %(picolibc_link_libgcc)

*link:
%{DPICOLIBC_DOUBLE_PRINTF_SCANF:--defsym=vfprintf=__d_vfprintf} %{DPICOLIBC_DOUBLE_PRINTF_SCANF:--defsym=vfscanf=__d_vfscanf} %{DPICOLIBC_FLOAT_PRINTF_SCANF:--defsym=vfprintf=__f_vfprintf} %{DPICOLIBC_FLOAT_PRINTF_SCANF:--defsym=vfscanf=__f_vfscanf} %{DPICOLIBC_LONG_LONG_PRINTF_SCANF:--defsym=vfprintf=__l_vfprintf} %{DPICOLIBC_LONG_LONG_PRINTF_SCANF:--defsym=vfscanf=__l_vfscanf} %{DPICOLIBC_INTEGER_PRINTF_SCANF:--defsym=vfprintf=__i_vfprintf} %{DPICOLIBC_INTEGER_PRINTF_SCANF:--defsym=vfscanf=__i_vfscanf} %{DPICOLIBC_MINIMAL_PRINTF_SCANF:--defsym=vfprintf=__m_vfprintf} %{DPICOLIBC_MINIMAL_PRINTF_SCANF:--defsym=vfscanf=__m_vfscanf} -L%{-picolibc-prefix=*:%*/picolibc/msp430/lib; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/lib/%*; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/lib} %{-printf=*:--defsym=vfprintf=__%*_vfprintf} %{-scanf=*:--defsym=vfscanf=__%*_vfscanf} %{!T:-Tpicolibc.ld}  %(picolibc_link)

*lib:
--start-group %(libgcc) %{mhwmult=auto:%{mmcu=*:%:msp430_hwmult_lib(mcu %{mmcu=*:%*});:%:msp430_hwmult_lib(default)};   mhwmult=*:%:msp430_hwmult_lib(hwmult %{mhwmult=*:%*});   mmcu=*:%:msp430_hwmult_lib(mcu %{mmcu=*:%*});		  :%:msp430_hwmult_lib(default)}			 -lc %{-oslib=*:-l%*} --end-group

*endfile:


*startfile:
%{-picolibc-prefix=*:%*/picolibc/msp430/lib/%{-crt0=*:crt0-%*%O; :crt0%O}; -picolibc-buildtype=*:/home/patrick/Work/picolibc-build/bin/picolibc/msp430/lib/%*/%{-crt0=*:crt0-%*%O; :crt0%O}; :/home/patrick/Work/picolibc-build/bin/picolibc/msp430/lib/%{-crt0=*:crt0-%*%O; :crt0%O}} 

